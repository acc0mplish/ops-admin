# Copy this file to deploy/.env and replace every password before deployment.
TZ=Asia/Shanghai
MYSQL_DATABASE=ops_admin
MYSQL_USER=ops_admin
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password
OPS_ADMIN_JWT_SECRET=replace_with_a_stable_random_jwt_secret_at_least_32_bytes
OPS_ADMIN_INITIAL_USERNAME=admin
OPS_ADMIN_INITIAL_PASSWORD=replace_with_a_strong_initial_admin_password
# Comma-separated browser origins when API is exposed cross-origin. Leave empty for same-origin deployment.
OPS_ADMIN_CORS_ORIGINS=
# Used only with docker-compose.dns.yml. In production, prefer the server's private IP.
OPS_ADMIN_DNS_BIND_ADDRESS=0.0.0.0
