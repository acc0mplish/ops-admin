# Copy this file to deploy/.env and replace every password before deployment.
TZ=Asia/Shanghai
MYSQL_DATABASE=ops_admin
MYSQL_USER=ops_admin
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password
# Optional when the deployment configuration is stored outside the Git workspace.
# OPS_ADMIN_CONFIG_PATH=/home/testvm/.config/ops-admin/config.yaml
