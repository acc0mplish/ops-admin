  "cards": [
    {
      "dot": "cyan",
      "title": "前端与 API",
      "items": [
        "Vue 3 单页控制台按资产、运维、应用、通知和监控领域组织",
        "Gin 对外提供鉴权 REST API 与终端 WebSocket 通道",
        "JWT、RBAC 与操作审计共同约束平台操作"
      ]
    },
    {
      "dot": "emerald",
      "title": "CMDB 与执行引擎",
      "items": [
        "CMDB 统一维护主机、数据库、K8s 集群、凭据和访问网关",
        "SSH 网关为隔离网络中的基础设施提供受控访问入口",
        "调度器驱动快速执行、作业、监控评估和数据库备份"
      ]
    },
    {
      "dot": "violet",
      "title": "交付与可观测",
      "items": [
        "应用构建在指定执行节点拉取 Git 或 SVN 代码",
        "CI/CD 流水线将构建结果发布到主机或 Kubernetes 环境",
        "指标与日志支持 Prometheus、VictoriaMetrics、Elasticsearch 和 VictoriaLogs"
      ]
    },
    {
      "dot": "amber",
      "title": "平台集成",
      "items": [
        "消息模板通过钉钉、企业微信、飞书或自定义 Webhook 发送",
        "LDAP/AD 为系统用户提供目录同步能力",
        "集成中心提供分组导航以及可选的免登录公开链接"
      ]
    }
